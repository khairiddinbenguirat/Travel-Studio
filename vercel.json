
{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "private/**"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/gateway?action=app"
    },
    {
      "src": "/index.html",
      "dest": "/api/gateway?action=app"
    },
    {
      "src": "/api/gateway",
      "dest": "/api/gateway"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
